---
// src/components/Work.astro
import { Image } from "astro:assets";
import { galleries } from "../data/site";
---

<section id="work" class="container-x section-y border-t border-line">
    <div class="mb-10 space-y-3 md:mb-14">
        <p class="eyebrow">Portfolio</p>
        <h2 class="heading">Selected work</h2>
    </div>

    <div class="grid gap-10 sm:grid-cols-2 sm:gap-6">
        {
            galleries.map((gallery) => (
                <a href={`/work/${gallery.slug}`} class="group block">
                    <div class="overflow-hidden bg-line">
                        <Image
                            src={gallery.cover.src}
                            alt={`${gallery.title} gallery cover`}
                            widths={[480, 720, 1080]}
                            width={1080}
                            sizes="(min-width: 640px) 50vw, 100vw"
                            class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                        />
                    </div>
                    <div class="mt-4 flex items-baseline justify-between gap-4">
                        <h3 class="font-serif text-2xl">{gallery.title}</h3>
                        <span class="text-sm text-ink-muted">
                            {gallery.photos.length} photos
                        </span>
                    </div>
                    <p class="mt-1 text-sm text-ink-muted">
                        {gallery.description}
                    </p>
                    <span class="mt-3 inline-block text-sm font-medium underline decoration-line underline-offset-4 transition-colors group-hover:decoration-ink">
                        View gallery
                    </span>
                </a>
            ))
        }
    </div>
</section>
