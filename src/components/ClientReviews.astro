---
// src/components/ClientReviews.astro

const reviews = [
    {
        quote: "Client reviews arriving soon",
        client: "Dan",
    },
    {
        quote: "Client reviews arriving soon",
        client: "Dan",
    },
    {
        quote: "Client reviews arriving soon",
        client: "Dan",
    },
    {
        quote: "Client reviews arriving soon",
        client: "Dan",
    },
];
---

<section
    class="relative w-full py-12 md:py-16 overflow-hidden border-t border-line"
>
    <!-- Background Image -->
    <div
        class="absolute inset-0 w-full h-full bg-cover bg-center filter brightness-90 contrast-105"
        style="background-image: url('/clientreviews.jpg');"
    >
    </div>
    <div class="absolute inset-0 bg-black/10"></div>

    <!-- Centered Solid White Card Container -->
    <div class="relative z-10 max-w-2xl mx-auto px-6">
        <div
            class="bg-white border border-line shadow-xl p-6 sm:p-8 md:p-10 text-center space-y-6"
        >
            <!-- Large Editorial Quote Icon -->
            <div class="flex justify-center text-ink/70">
                <svg
                    class="w-10 h-10 md:w-12 md:h-12"
                    viewBox="0 0 64 64"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                >
                    <path
                        d="M20 38C16 38 13 35 13 30C13 22 20 14 29 12L31 15C25 18 21 22 20 26C22 26 25 27 25 31C25 35 22 38 20 38ZM44 38C40 38 37 35 37 30C37 22 44 14 53 12L55 15C49 18 45 22 44 26C46 26 49 27 49 31C49 35 46 38 44 38Z"
                    ></path>
                </svg>
            </div>

            <!-- Review Carousel Window -->
            <div
                class="relative overflow-hidden min-h-[120px] flex items-center justify-center"
            >
                <div
                    id="review-track"
                    class="w-full flex transition-transform duration-700 ease-in-out"
                >
                    {
                        reviews.map((review) => (
                            <div class="w-full flex-shrink-0 px-2 space-y-4">
                                <p class="font-serif italic text-sm sm:text-base md:text-lg text-ink leading-relaxed font-light">
                                    "{review.quote}"
                                </p>
                                <p class="font-sans text-xs tracking-[0.2em] uppercase text-ink-muted font-medium">
                                    {review.client}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Navigation Dots -->
            <div class="flex justify-center items-center space-x-2 pt-2">
                {
                    reviews.map((_, i) => (
                        <button
                            class="review-dot w-2 h-2 rounded-full border border-ink/40 transition-all duration-300 focus:outline-none"
                            data-index={i}
                            aria-label={`Go to review ${i + 1}`}
                        />
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script>
    const track = document.getElementById("review-track");
    const dots = document.querySelectorAll<HTMLElement>(".review-dot");
    const totalReviews = dots.length;
    let currentIndex = 0;
    let intervalId: ReturnType<typeof setInterval>;

    function updateSlider(index: number) {
        currentIndex = index;
        if (track) {
            track.style.transform = `translateX(-${currentIndex * 100}%)`;
        }

        dots.forEach((dot, i) => {
            if (i === currentIndex) {
                dot.classList.add("bg-ink", "w-5");
                dot.classList.remove("bg-transparent", "w-2");
            } else {
                dot.classList.remove("bg-ink", "w-5");
                dot.classList.add("bg-transparent", "w-2");
            }
        });
    }

    function startAutoPlay() {
        intervalId = setInterval(() => {
            const nextIndex = (currentIndex + 1) % totalReviews;
            updateSlider(nextIndex);
        }, 5000);
    }

    dots.forEach((dot) => {
        dot.addEventListener("click", (e) => {
            const target = e.currentTarget as HTMLElement;
            const index = parseInt(
                target.getAttribute("data-index") || "0",
                10,
            );
            clearInterval(intervalId);
            updateSlider(index);
            startAutoPlay();
        });
    });

    updateSlider(0);
    startAutoPlay();
</script>
