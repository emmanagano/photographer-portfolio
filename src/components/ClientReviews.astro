---
// src/components/ClientReviews.astro

const reviews = [
    { quote: "Client reviews arriving soon", client: "Dan" },
    { quote: "Client reviews arriving soon", client: "Dan" },
    { quote: "Client reviews arriving soon", client: "Dan" },
    { quote: "Client reviews arriving soon", client: "Dan" },
];
---

<section class="section-y border-t border-line">
    <div class="container-x mb-10 space-y-3 md:mb-14">
        <p class="eyebrow">Reviews</p>
        <h2 class="heading">Kind words</h2>
    </div>

    <!-- Swipeable row on mobile, grid on larger screens -->
    <ul
        class="container-x flex snap-x snap-mandatory scroll-px-5 gap-4 sm:scroll-px-8 overflow-x-auto pb-2 [scrollbar-width:none] md:grid md:grid-cols-2 md:overflow-visible lg:grid-cols-4"
    >
        {
            reviews.map((review) => (
                <li class="w-[85%] shrink-0 snap-start border border-line bg-card p-6 md:w-auto">
                    <blockquote class="font-serif text-xl leading-snug italic">
                        “{review.quote}”
                    </blockquote>
                    <p class="eyebrow mt-6">{review.client}</p>
                </li>
            ))
        }
    </ul>
</section>
