---
// src/components/NavLink.astro
interface Props {
    href: string;
    label: string;
}

const { href, label } = Astro.props;
const pathname = Astro.url.pathname;

// Check if the link matches the active route
const isActive =
    pathname === href || (href !== "/" && pathname.startsWith(href));
---

<a
    href={href}
    class:list={[
        "text-xs uppercase tracking-widest transition-colors duration-200",
        isActive
            ? "text-ink font-medium border-b border-ink pb-1"
            : "text-ink-muted hover:text-ink",
    ]}
>
    {label}
</a>
