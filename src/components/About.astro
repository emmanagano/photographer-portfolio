---
// src/components/About.astro
import { Image } from "astro:assets";
import profile from "../assets/profile.jpg";
---

<section id="about" class="container-x section-y">
    <div class="grid items-center gap-10 md:grid-cols-2 md:gap-16">
        <Image
            src={profile}
            alt="Portrait of Dan"
            widths={[480, 720, 1080]}
            width={1080}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="aspect-[4/5] w-full object-cover md:order-2"
        />

        <div class="space-y-6 md:order-1">
            <p class="eyebrow">About</p>
            <h2 class="heading">Hi, I'm Dan.</h2>
            <p class="max-w-lg text-ink-muted sm:text-lg">
                I'm a creator dedicated to preserving your most important
                milestones. Whether I'm tracking the action at a game, capturing
                tears of joy at a wedding, or shooting sweeping drone
                landscapes, my goal is to make the process easy, comfortable and
                fun. Let's create something memorable together.
            </p>
        </div>
    </div>
</section>
