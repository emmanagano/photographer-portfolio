---
// src/components/Hero.astro
import Button from "./Button.astro";
---

<section class="max-w-7xl mx-auto px-6 pt-20 pb-16 md:pt-32 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Hero Text Content -->
        <div class="lg:col-span-7 space-y-8">
            <div class="inline-block border-b border-ink/20 pb-1">
                <span
                    class="text-xs uppercase tracking-widest text-ink-muted font-mono"
                >
                    MEDIA PRODUCTION & PHOTOGRAPHY
                </span>
            </div>

            <h1
                class="font-serif text-5xl sm:text-6xl md:text-7xl font-normal leading-[1.08] tracking-tight text-ink"
            >
                Capturing life's biggest moments, frame by frame
            </h1>

            <p
                class="text-ink-muted text-base sm:text-lg max-w-xl font-light leading-relaxed"
            >
                Specializing in sports, weddings, celebrations, and complete
                media production.
            </p>

            <div class="flex flex-wrap items-center gap-4 pt-2">
                <Button text="VIEW MY WORK" href="#work" variant="filled" />
                <Button text="GET IN TOUCH" href="#contact" variant="outline" />
            </div>
        </div>

        <!-- Media / Image Frame -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
            <div
                class="relative w-full max-w-md aspect-[4/5] bg-line/20 border border-line overflow-hidden shadow-sm flex flex-col justify-between p-4"
            >
                <div
                    class="flex justify-between items-center text-[10px] font-mono uppercase tracking-wider text-ink-muted z-10"
                >
                    <span>Plate No. 01</span>
                    <span>2026 Edition</span>
                </div>

                <div
                    class="absolute inset-0 pt-12 pb-10 px-4 flex items-center justify-center"
                >
                    <img
                        src="/hero.jpg"
                        alt="Hero Visual Narrative"
                        class="w-full h-full object-cover contrast-105 transition-all duration-700"
                    />
                </div>

                <div
                    class="flex justify-between items-center text-[10px] font-mono text-ink-muted z-10"
                >
                    <span>01 — 04</span>
                    <span>Scroll to Explore</span>
                </div>
            </div>
        </div>
    </div>
</section>
