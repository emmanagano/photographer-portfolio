---
// src/components/Hero.astro
import { Image } from "astro:assets";
import Button from "./Button.astro";
import hero from "../assets/hero.jpg";
---

<section class="container-x pt-10 pb-16 md:pt-20 md:pb-28">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="space-y-6 lg:col-span-5">
            <p class="eyebrow">Photography & Media Production</p>
            <h1
                class="font-serif text-[2.75rem] leading-[1.05] tracking-tight sm:text-6xl"
            >
                Capturing life's biggest moments, frame by frame.
            </h1>
            <p class="max-w-md text-ink-muted sm:text-lg">
                Sports, weddings, celebrations, real estate and aerial, from the
                shoot to the final edit.
            </p>
            <div class="flex flex-col gap-3 pt-2 sm:flex-row">
                <Button href="#work" variant="filled">View my work</Button>
                <Button href="#contact">Get in touch</Button>
            </div>
        </div>

        <div class="lg:col-span-7">
            <Image
                src={hero}
                alt="Dan holding a kite in an open field, in black and white"
                widths={[640, 960, 1400, 1920]}
                width={1920}
                sizes="(min-width: 1024px) 680px, 100vw"
                loading="eager"
                fetchpriority="high"
                class="aspect-[4/3] w-full object-cover"
            />
        </div>
    </div>
</section>
