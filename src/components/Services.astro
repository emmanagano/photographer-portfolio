---
// src/components/Services.astro
import Button from "./Button.astro";

const services = [
    {
        title: "Photography & Retouching",
        description:
            "Action shots, heartfelt wedding moments and vibrant celebrations, captured with care and professionally retouched.",
    },
    {
        title: "Filming & Videography",
        description:
            "Cinematic coverage for events, promos and special occasions that lets you relive the experience.",
    },
    {
        title: "Video Editing",
        description:
            "Raw footage turned into polished stories, with smooth pacing, color grading and audio cleanup.",
    },
    {
        title: "Aerial & Drone",
        description:
            "Licensed drone photography and video for a breathtaking, high-perspective view.",
    },
    {
        title: "Photo Printing",
        description:
            "High-quality prints that turn your digital memories into something you can hold and display.",
    },
];
---

<section id="services" class="container-x section-y border-t border-line">
    <div class="mb-10 space-y-3 md:mb-14">
        <p class="eyebrow">Services</p>
        <h2 class="heading">What I offer</h2>
    </div>

    <ol class="grid gap-x-12 md:grid-cols-2">
        {
            services.map((service, i) => (
                <li class="flex gap-5 border-t border-line py-6">
                    <span class="pt-1 text-sm text-ink-muted tabular-nums">
                        {String(i + 1).padStart(2, "0")}
                    </span>
                    <div class="space-y-2">
                        <h3 class="font-serif text-2xl">{service.title}</h3>
                        <p class="text-ink-muted">{service.description}</p>
                    </div>
                </li>
            ))
        }
    </ol>

    <div class="mt-10">
        <Button href="#contact">Inquire about a project</Button>
    </div>
</section>
