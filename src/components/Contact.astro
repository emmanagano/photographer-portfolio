---
// src/components/Contact.astro
import Button from "./Button.astro";
---

<section id="contact" class="max-w-2xl mx-auto px-6 py-24 border-t border-line">
    <!-- Header -->
    <div class="text-center mb-12 space-y-3">
        <h2
            class="font-serif text-3xl md:text-4xl tracking-[0.2em] uppercase text-ink"
        >
            CONTACT ME
        </h2>
        <div class="w-8 h-[1px] bg-ink/30 mx-auto"></div>
    </div>

    <!-- Minimal Form -->
    <form class="space-y-8" onsubmit="event.preventDefault();">
        <!-- Name Field -->
        <div class="relative">
            <input
                type="text"
                id="name"
                name="name"
                required
                placeholder=" "
                class="peer w-full bg-transparent border-b border-ink/40 py-2 text-ink text-sm md:text-base focus:border-ink focus:outline-none transition-colors"
            />
            <label
                for="name"
                class="absolute left-0 top-2 text-xs md:text-sm text-ink-muted pointer-events-none transition-all duration-300 peer-focus:-top-4 peer-focus:text-[10px] peer-focus:text-ink peer-[:not(:placeholder-shown)]:-top-4 peer-[:not(:placeholder-shown)]:text-[10px]"
            >
                Name
            </label>
        </div>

        <!-- Email Field -->
        <div class="relative">
            <input
                type="email"
                id="email"
                name="email"
                required
                placeholder=" "
                class="peer w-full bg-transparent border-b border-ink/40 py-2 text-ink text-sm md:text-base focus:border-ink focus:outline-none transition-colors"
            />
            <label
                for="email"
                class="absolute left-0 top-2 text-xs md:text-sm text-ink-muted pointer-events-none transition-all duration-300 peer-focus:-top-4 peer-focus:text-[10px] peer-focus:text-ink peer-[:not(:placeholder-shown)]:-top-4 peer-[:not(:placeholder-shown)]:text-[10px]"
            >
                Email
            </label>
        </div>

        <!-- Subject Field -->
        <div class="relative">
            <input
                type="text"
                id="subject"
                name="subject"
                placeholder=" "
                class="peer w-full bg-transparent border-b border-ink/40 py-2 text-ink text-sm md:text-base focus:border-ink focus:outline-none transition-colors"
            />
            <label
                for="subject"
                class="absolute left-0 top-2 text-xs md:text-sm text-ink-muted pointer-events-none transition-all duration-300 peer-focus:-top-4 peer-focus:text-[10px] peer-focus:text-ink peer-[:not(:placeholder-shown)]:-top-4 peer-[:not(:placeholder-shown)]:text-[10px]"
            >
                Subject
            </label>
        </div>

        <!-- Message Field -->
        <div class="relative pt-2">
            <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder=" "
                class="peer w-full bg-transparent border border-ink/30 p-3 text-ink text-sm md:text-base focus:border-ink focus:outline-none transition-colors resize-none"
            ></textarea>
            <label
                for="message"
                class="absolute left-3 top-5 text-xs md:text-sm text-ink-muted pointer-events-none transition-all duration-300 peer-focus:top-0 peer-focus:text-[10px] peer-focus:text-ink peer-[:not(:placeholder-shown)]:top-0 peer-[:not(:placeholder-shown)]:text-[10px]"
            >
                Message
            </label>
        </div>

        <!-- Submit Button -->
        <div class="pt-4 text-center">
            <button
                type="submit"
                class="inline-block px-10 py-3 border border-ink text-xs md:text-sm tracking-[0.2em] uppercase text-ink hover:bg-ink hover:text-paper transition-all duration-300 cursor-pointer"
            >
                Send
            </button>
        </div>
    </form>
</section>
