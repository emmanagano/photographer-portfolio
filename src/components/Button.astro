---
// src/components/Button.astro
// Renders a link when `href` is given, otherwise a <button>.
interface Props {
    href?: string;
    type?: "button" | "submit";
    variant?: "outline" | "filled" | "light";
    external?: boolean;
    class?: string;
}

const {
    href,
    type = "button",
    variant = "outline",
    external = false,
    class: className,
} = Astro.props;

const variants = {
    outline: "border-ink text-ink hover:bg-ink hover:text-paper",
    filled: "border-ink bg-ink text-paper hover:bg-ink/85",
    light: "border-white text-white hover:bg-white hover:text-ink",
};
const classes = [
    "inline-flex min-h-12 items-center justify-center gap-2 border px-7 text-sm font-medium transition-colors duration-200 cursor-pointer",
    variants[variant],
    className,
];
---

{
    href ? (
        <a
            href={href}
            class:list={classes}
            {...(external && { target: "_blank", rel: "noopener noreferrer" })}
        >
            <slot />
        </a>
    ) : (
        <button type={type} class:list={classes}>
            <slot />
        </button>
    )
}
