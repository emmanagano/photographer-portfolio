---
// src/components/ParallaxBanner.astro
interface Props {
    quote?: string;
    subtext?: string;
    bgImage?: string;
}

const {
    quote = "Capturing your milestones, from the ground up.",
    subtext = "SPORTS • WEDDINGS • EVENTS • AERIAL",
    bgImage = "/bannerimage.jpg",
} = Astro.props;
---

<section
    class="relative w-full h-[55vh] min-h-[380px] max-h-[550px] overflow-hidden my-16 flex items-center justify-center"
>
    <!-- Parallax Background Container -->
    {
        bgImage ? (
            <div
                class="absolute inset-0 w-full h-full bg-cover bg-center bg-fixed"
                style={`background-image: url('${bgImage}');`}
            />
        ) : (
            <div class="absolute inset-0 w-full h-full bg-neutral-900 bg-fixed flex items-center justify-center border-y border-neutral-800">
                <div class="absolute inset-0 bg-[radial-gradient(#333_1px,transparent_1px)] [background-size:16px_16px] opacity-20" />
            </div>
        )
    }

    <!-- Rich Gradient Overlay for Depth and Readability -->
    <div
        class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-black/70 backdrop-blur-[2px]"
    >
    </div>

    <!-- Centered Aesthetic Content -->
    <div
        class="relative z-10 max-w-3xl mx-auto px-6 text-center flex flex-col items-center space-y-4"
    >
        {
            subtext && (
                <span class="text-xs uppercase tracking-[0.25em] text-neutral-300 font-medium bg-white/10 px-3 py-1 rounded-full backdrop-blur-md">
                    {subtext}
                </span>
            )
        }

        <p
            class="font-serif text-2xl sm:text-3xl md:text-4xl text-white tracking-wide font-light leading-snug drop-shadow-md"
        >
            "{quote}"
        </p>

        <!-- Decorative subtle line -->
        <div class="w-12 h-[1px] bg-white/40 mt-2"></div>
    </div>
</section>
